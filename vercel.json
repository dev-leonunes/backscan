{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/config.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/c",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/c/",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/c/:dados",
      "destination": "/receipt.html"
    }
  ]
}
